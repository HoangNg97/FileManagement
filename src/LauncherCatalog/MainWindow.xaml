<Window x:Class="LauncherCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LauncherCatalog.Converters"
        Title="Launcher Catalog"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Icon="Assets/catalog_icon.ico"
        Background="{DynamicResource PageBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:EntryTypeToGlyphConverter x:Key="EntryTypeToGlyphConverter" />
        <conv:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter" />
        <conv:MissingStatusTextConverter x:Key="MissingStatusTextConverter" />
        <conv:MissingStatusBrushConverter x:Key="MissingStatusBrushConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVisibilityConverter" Invert="True" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="SearchPlaceholderConverter" />
        <conv:BooleanToOpacityConverter x:Key="FavoriteOpacityConverter" TrueOpacity="1" FalseOpacity="0.45" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="CardActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="CenteredDropdownTextTemplate">
            <TextBlock Text="{Binding}"
                       Foreground="{DynamicResource StrongTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="EverythingResultTemplate">
            <Border Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.25"
                    CornerRadius="10"
                    ToolTip="{Binding FullPath}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            CornerRadius="9"
                            Background="{DynamicResource ControlBrush}">
                        <TextBlock Text="{Binding Type, Converter={StaticResource EntryTypeToGlyphConverter}}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="380" />
                            <Border Margin="10,0,0,0"
                                    Padding="8,3"
                                    CornerRadius="7"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding SavedStatusText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FolderPath}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FolderPath}" />
                                <TextBlock Text="{Binding FileName}"
                                           Foreground="{DynamicResource StrongTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                Command="{Binding DataContext.AddEverythingResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="&#xE710;"
                                ToolTip="Add to catalog" />
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                Command="{Binding DataContext.OpenEverythingResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="&#xE768;"
                                ToolTip="Open" />
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                Command="{Binding DataContext.RevealEverythingResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="&#xE838;"
                                ToolTip="Reveal in Explorer" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding DataContext.CopyEverythingPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="&#xE8C8;"
                                ToolTip="Copy full path" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SmoothCatalogListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer Focusable="False"
                                          Padding="0,0,12,0">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      Margin="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Launcher Catalog"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultCountText}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="2,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource SwitchButtonStyle}"
                              IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                              Margin="0,0,10,0"
                              ToolTip="Toggle dark mode" />
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="&#xE765;"
                        Click="ShortcutSettings_Click"
                        Margin="0,0,10,0"
                        ToolTip="{Binding QuickSearchHotkeyToolTip}" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddAppCommand}"
                        MinWidth="118"
                        Margin="0,0,10,0"
                        ToolTip="Add application">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   LineHeight="16"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="Add App"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AddFolderCommand}"
                        MinWidth="132"
                        ToolTip="Add folder">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   LineHeight="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="Add Folder"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="430" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border MinHeight="34"
                                Background="{DynamicResource ControlBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <Grid Grid.Column="1"
                                      Margin="0,0,10,0">
                                    <TextBox x:Name="SearchBox"
                                             Style="{StaticResource SearchTextBoxStyle}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Search apps, folders, paths, tags, notes"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource SearchPlaceholderConverter}}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding SearchSources}"
                                  SelectedItem="{Binding SelectedSearchSource}"
                                  ItemTemplate="{StaticResource CenteredDropdownTextTemplate}"
                                  HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding Filters}"
                                  SelectedItem="{Binding SelectedFilter}"
                                  ItemTemplate="{StaticResource CenteredDropdownTextTemplate}"
                                  HorizontalContentAlignment="Center" />
                        <ComboBox Grid.Column="6"
                                  ItemsSource="{Binding SortModes}"
                                  SelectedItem="{Binding SelectedSort}"
                                  ItemTemplate="{StaticResource CenteredDropdownTextTemplate}"
                                  HorizontalContentAlignment="Center" />
                        <Button Grid.Column="8"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE72C;"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Refresh catalog" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,12,0">
                        <StackPanel>
                            <ListBox Style="{StaticResource SmoothCatalogListBoxStyle}"
                                     ItemsSource="{Binding EntriesView}"
                                     SelectedItem="{Binding SelectedEntry}"
                                     MouseDoubleClick="EntriesList_MouseDoubleClick"
                                     PreviewMouseWheel="ResultsList_PreviewMouseWheel"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding ShowCatalogResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardBorder"
                                                Padding="16"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1.25"
                                                CornerRadius="10"
                                                ToolTip="{Binding PrimaryPath}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="46"
                                                        Height="46"
                                                        CornerRadius="10"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <Grid>
                                                        <Image Source="{Binding IconPath}"
                                                               Width="30"
                                                               Height="30"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IconPath, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource EntryTypeToGlyphConverter}}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="20"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="340" />
                                                        <Border Margin="10,0,0,0"
                                                                Padding="8,3"
                                                                CornerRadius="7"
                                                                Background="{Binding IsMissing, Converter={StaticResource MissingStatusBrushConverter}}">
                                                            <TextBlock Text="{Binding IsMissing, Converter={StaticResource MissingStatusTextConverter}}"
                                                                       Foreground="{Binding IsMissing, Converter={StaticResource MissingStatusBrushConverter}, ConverterParameter=Foreground}"
                                                                       Style="{StaticResource BadgeTextStyle}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding TypeLabel}"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ExeName}"
                                                                       Foreground="{DynamicResource StrongTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Folder"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding FolderName}"
                                                                       Foreground="{DynamicResource StrongTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FolderPath}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <StackPanel Grid.Column="4"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"
                                                            Opacity="{Binding IsFavorite, Converter={StaticResource FavoriteOpacityConverter}}"
                                                            ToolTip="Favorite" />
                                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                                            Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE768;"
                                                            ToolTip="Open" />
                                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                                            Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE70F;"
                                                            ToolTip="Edit" />
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE74D;"
                                                            ToolTip="Delete" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SelectedItemBrush}" />
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SelectedItemBorderBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <DockPanel Margin="2,4,14,8"
                                       Visibility="{Binding ShowEverythingResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding EverythingStatusText}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StrongTextBrush}" />
                                <TextBlock Text="{Binding EverythingResults.Count, StringFormat={}{0} result(s)}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextAlignment="Right" />
                            </DockPanel>

                            <ListBox Style="{StaticResource SmoothCatalogListBoxStyle}"
                                     ItemsSource="{Binding EverythingResults}"
                                     ItemTemplate="{StaticResource EverythingResultTemplate}"
                                     PreviewMouseWheel="ResultsList_PreviewMouseWheel"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding ShowEverythingResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEverythingInfoState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Width="360">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="30"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EverythingStatusText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,12,0,4" />
                            <TextBlock Text="Catalog search is still available. Embedded Everything results require the command-line query tool."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyCatalogState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Width="340">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="No saved items yet"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,12,0,4" />
                            <TextBlock Text="Add an app or folder to create your searchable launcher list."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Select an item"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,12,0,4" />
                        <TextBlock Text="Details and actions appear here."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Visibility="{Binding SelectedEntry, Converter={StaticResource NotNullToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="10"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    DockPanel.Dock="Left"
                                    Margin="0,0,12,0">
                                <Grid>
                                    <Image Source="{Binding SelectedEntry.IconPath}"
                                           Width="29"
                                           Height="29"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SelectedEntry.IconPath, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedEntry.Type, Converter={StaticResource EntryTypeToGlyphConverter}}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="19"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SelectedEntry.IconPath, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <StackPanel>
                                <TextBox Text="{Binding SelectedEntry.DisplayName, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Foreground="{DynamicResource StrongTextBrush}"
                                         FontSize="21"
                                         FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.TypeLabel, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Full path" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.PrimaryPath, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         ToolTip="{Binding SelectedEntry.PrimaryPath}"
                                         Margin="0,5,0,14" />

                                <TextBlock Text="File" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.ExeName, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Margin="0,5,0,14" />

                                <TextBlock Text="Folder" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.FolderName, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         ToolTip="{Binding SelectedEntry.FolderPath}"
                                         Margin="0,5,0,14" />

                                <TextBlock Text="Tags" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.TagsText, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Margin="0,5,0,14" />

                                <TextBlock Text="Note" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.Note, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Margin="0,5,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Added" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SelectedEntry.DateAddedText, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Last opened" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SelectedEntry.LastOpenedText, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding OpenEntryCommand}"
                                    CommandParameter="{Binding SelectedEntry}"
                                    Content="Open"
                                    MinHeight="40" />
                            <UniformGrid Grid.Row="2"
                                         Columns="4"
                                         Rows="1">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenContainingFolderCommand}"
                                        Content="&#xE838;"
                                        ToolTip="Reveal in Explorer"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CopyPathCommand}"
                                        Content="&#xE8C8;"
                                        ToolTip="Copy full path"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ToggleFavoriteCommand}"
                                        CommandParameter="{Binding SelectedEntry}"
                                        Content="{Binding SelectedEntry.IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"
                                        ToolTip="Favorite"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding DeleteEntryCommand}"
                                        CommandParameter="{Binding SelectedEntry}"
                                        Content="&#xE74D;"
                                        ToolTip="Remove from catalog" />
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4"
                   LastChildFill="True">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="{Binding StoragePath}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextAlignment="Right"
                       ToolTip="{Binding StoragePath}" />
        </DockPanel>

        <Grid Grid.RowSpan="5"
              Panel.ZIndex="20"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Rectangle Fill="{DynamicResource PageBrush}"
                       Opacity="0.94" />
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid Width="54"
                      Height="54"
                      HorizontalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource BorderBrush}"
                             StrokeThickness="5"
                             Opacity="0.65" />
                    <Ellipse Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="5"
                             StrokeDashArray="2 5"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LoadingRingRotate" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadingRingRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.85" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="{Binding LoadingMessage}"
                           Foreground="{DynamicResource StrongTextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
