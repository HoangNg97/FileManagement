<Window x:Class="LauncherCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LauncherCatalog.Behaviors"
        xmlns:conv="clr-namespace:LauncherCatalog.Converters"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        xmlns:models="clr-namespace:LauncherCatalog.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:LauncherCatalog.Views"
        Title="{loc:Loc Common.AppName}"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="Assets/catalog_icon.ico"
        Background="{DynamicResource PageBrush}"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:EntryTypeToGlyphConverter x:Key="EntryTypeToGlyphConverter" />
        <conv:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter" />
        <conv:MissingStatusTextConverter x:Key="MissingStatusTextConverter" />
        <conv:MissingStatusBrushConverter x:Key="MissingStatusBrushConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVisibilityConverter" Invert="True" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="SearchPlaceholderConverter" />
        <conv:BooleanToOpacityConverter x:Key="FavoriteOpacityConverter" TrueOpacity="1" FalseOpacity="0.45" />
        <conv:TaskDepthToIndentConverter x:Key="TaskDepthToIndentConverter" IndentSize="24" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="CardActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Clean template for the caption/title-bar icon buttons so glyphs are always centered
             and never clipped by the default WPF button chrome. -->
        <Style x:Key="TitleBarIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFF4EDE6" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditableNoteBodyStyle" TargetType="{x:Type RichTextBox}">
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="CaretBrush" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RichTextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="CenteredDropdownTextTemplate">
            <TextBlock Text="{Binding DisplayText}"
                       Foreground="{DynamicResource StrongTextBrush}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       TextAlignment="Left" />
        </DataTemplate>

        <DataTemplate x:Key="EverythingResultTemplate">
            <Border Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.25"
                    CornerRadius="10"
                    ToolTip="{Binding FullPath}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            CornerRadius="9"
                            Background="{DynamicResource ControlBrush}">
                        <TextBlock Text="{Binding Type, Converter={StaticResource EntryTypeToGlyphConverter}}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="380" />
                            <Border Margin="10,0,0,0"
                                    Padding="8,3"
                                    CornerRadius="7"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding SavedStatusText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FolderPathPreview}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FolderPath}" />
                                <TextBlock Text="{Binding FileName}"
                                           Foreground="{DynamicResource StrongTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                Command="{Binding DataContext.AddEverythingResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="&#xE710;"
                                ToolTip="{loc:Loc Main.Action.AddToCatalog}" />
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                Command="{Binding DataContext.OpenEverythingResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="&#xE768;"
                                ToolTip="{loc:Loc Common.Open}" />
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                Command="{Binding DataContext.RevealEverythingResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="&#xE838;"
                                ToolTip="{loc:Loc Common.RevealInExplorer}" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding DataContext.CopyEverythingPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="&#xE8C8;"
                                ToolTip="{loc:Loc Common.CopyFullPath}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SmoothCatalogListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer Focusable="False"
                                          Padding="0,0,12,0">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      Margin="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8">
                                <TabPanel x:Name="HeaderPanel"
                                          Margin="0"
                                          IsItemsHost="True"
                                          Background="Transparent"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Padding" Value="14,8,14,10" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3" />
                            </Grid.RowDefinitions>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}" />
                            <Border x:Name="ActiveLine"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    Margin="0,2,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ActiveLine" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskStatusBadgeBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FFEFF6FF" />
            <Setter Property="BorderBrush" Value="#FFBFDBFE" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskStatus.Todo}">
                    <Setter Property="Background" Value="#FFFEECEC" />
                    <Setter Property="BorderBrush" Value="#FFFCCACA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskStatus.Ongoing}">
                    <Setter Property="Background" Value="#FFEDFDF3" />
                    <Setter Property="BorderBrush" Value="#FFA7F3D0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskStatus.Done}">
                    <Setter Property="Background" Value="#FFEFF6FF" />
                    <Setter Property="BorderBrush" Value="#FFBFDBFE" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskStatusBadgeTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FF1D4ED8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskStatus.Todo}">
                    <Setter Property="Foreground" Value="#FFB42318" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskStatus.Ongoing}">
                    <Setter Property="Foreground" Value="#FF087443" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TaskStatus.Done}">
                    <Setter Property="Foreground" Value="#FF1D4ED8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskPriorityStripeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="{x:Static models:TaskPriority.Normal}">
                    <Setter Property="Background" Value="#FF94A3B8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="{x:Static models:TaskPriority.Urgent}">
                    <Setter Property="Background" Value="#FFDC2626" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskInlineTextToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskInlineDateFieldStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource TaskInlineTextToggleStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="FieldBorder"
                                Background="{DynamicResource ControlBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactTaskActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="TaskTreeIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="TaskInlineTitleEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TaskChevronGlyphStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="90"
                                                 Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="0"
                                                 Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubtaskConnectorLineStyle" TargetType="{x:Type Line}">
            <Setter Property="Stroke" Value="#FFB7BCC5" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="1.2,1.4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#AA5C4B3E"
                BorderBrush="#806F5A4A"
                BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="{loc:Loc Common.AppName}"
                               Foreground="#FFF4EDE6"
                               FontWeight="SemiBold"
                               FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarIconButtonStyle}"
                            FontSize="15"
                            Content="&#xE713;"
                            Click="Settings_Click"
                            ToolTip="{loc:Loc Settings.Open.Tooltip}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource TitleBarIconButtonStyle}"
                            Content="&#xE921;"
                            Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource TitleBarIconButtonStyle}"
                            Content="&#xE922;"
                            Click="MaxRestore_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource TitleBarIconButtonStyle}"
                            Width="50"
                            Content="&#xE8BB;"
                            Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
        <TabControl Style="{StaticResource MainTabControlStyle}">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource MainTabItemStyle}" />
            </TabControl.Resources>
            <TabItem Header="{loc:Loc Main.Tab.Catalog}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{loc:Loc Common.AppName}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultCountText}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="2,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="&#xE777;"
                        Click="RestoreLatestBackup_Click"
                        Margin="0,0,10,0"
                        ToolTip="{loc:Loc Backup.RestoreLatest.Tooltip}" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddAppCommand}"
                        MinWidth="118"
                        Margin="0,0,10,0"
                        ToolTip="{loc:Loc Main.Tooltip.AddApplication}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   LineHeight="16"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc Main.Action.AddApp}"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AddFolderCommand}"
                        MinWidth="132"
                        ToolTip="{loc:Loc Main.Tooltip.AddFolder}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   LineHeight="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc Main.Action.AddFolder}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="430" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border MinHeight="34"
                                Background="{DynamicResource ControlBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <Grid Grid.Column="1"
                                      Margin="0,0,10,0">
                                    <TextBox x:Name="SearchBox"
                                             Style="{StaticResource SearchTextBoxStyle}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                                    <TextBlock Text="{loc:Loc Common.SearchEllipsis}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource SearchPlaceholderConverter}}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding SearchSources}"
                                  SelectedItem="{Binding SelectedSearchSourceOption}"
                                  ItemTemplate="{StaticResource CenteredDropdownTextTemplate}" />
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding Filters}"
                                  SelectedItem="{Binding SelectedFilterOption}"
                                  ItemTemplate="{StaticResource CenteredDropdownTextTemplate}" />
                        <ComboBox Grid.Column="6"
                                  ItemsSource="{Binding SortModes}"
                                  SelectedItem="{Binding SelectedSortOption}"
                                  ItemTemplate="{StaticResource CenteredDropdownTextTemplate}" />
                        <Button Grid.Column="8"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE72C;"
                                Command="{Binding RefreshCommand}"
                                ToolTip="{loc:Loc Main.Action.RefreshCatalog}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,18,0">
                        <StackPanel>
                            <ListBox x:Name="EntriesList"
                                     Style="{StaticResource SmoothCatalogListBoxStyle}"
                                     ItemsSource="{Binding EntriesView}"
                                     SelectedItem="{Binding SelectedEntry}"
                                     MouseDoubleClick="EntriesList_MouseDoubleClick"
                                     PreviewMouseWheel="ResultsList_PreviewMouseWheel"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding ShowCatalogResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,14,10" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardBorder"
                                                Padding="16"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1.25"
                                                CornerRadius="10"
                                                ToolTip="{Binding PrimaryPath}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="46"
                                                        Height="46"
                                                        CornerRadius="10"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <Grid>
                                                        <Image Source="{Binding IconPath}"
                                                               Width="30"
                                                               Height="30"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IconPath, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource EntryTypeToGlyphConverter}}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="20"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="340" />
                                                        <Border Margin="10,0,0,0"
                                                                Padding="8,3"
                                                                CornerRadius="7"
                                                                Background="{Binding IsMissing, Converter={StaticResource MissingStatusBrushConverter}}">
                                                            <TextBlock Text="{Binding IsMissing, Converter={StaticResource MissingStatusTextConverter}}"
                                                                       Foreground="{Binding IsMissing, Converter={StaticResource MissingStatusBrushConverter}, ConverterParameter=Foreground}"
                                                                       Style="{StaticResource BadgeTextStyle}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding TypeLabel}"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ExeName}"
                                                                       Foreground="{DynamicResource StrongTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{loc:Loc Common.Folder}"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding FolderName}"
                                                                       Foreground="{DynamicResource StrongTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FolderPath}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <StackPanel Grid.Column="4"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"
                                                            Opacity="{Binding IsFavorite, Converter={StaticResource FavoriteOpacityConverter}}"
                                                            ToolTip="{loc:Loc Common.Favorite}" />
                                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                                            Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE768;"
                                                            ToolTip="{loc:Loc Common.Open}" />
                                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                                            Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE70F;"
                                                            ToolTip="{loc:Loc Common.Edit}" />
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE74D;"
                                                            ToolTip="{loc:Loc Common.Delete}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SelectedItemBrush}" />
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SelectedItemBorderBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <DockPanel Margin="2,4,14,8"
                                       Visibility="{Binding ShowEverythingResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding EverythingStatusText}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StrongTextBrush}" />
                                <TextBlock Text="{Binding EverythingResultCountText}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextAlignment="Right" />
                            </DockPanel>

                            <ListBox Style="{StaticResource SmoothCatalogListBoxStyle}"
                                     ItemsSource="{Binding EverythingResults}"
                                     ItemTemplate="{StaticResource EverythingResultTemplate}"
                                     PreviewMouseWheel="ResultsList_PreviewMouseWheel"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding ShowEverythingResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,14,10" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Border Margin="2,4,14,8"
                                    Padding="24"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding ShowEverythingInfoState, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="26"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding EverythingInfoTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="{Binding EverythingInfoMessage}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyCatalogState, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Width="340">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Main.EmptyCatalog.Title}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,12,0,4" />
                            <TextBlock Text="{loc:Loc Main.EmptyCatalog.Message}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc Main.EmptySelection.Title}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,12,0,4" />
                        <TextBlock Text="{loc:Loc Main.EmptySelection.Message}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Visibility="{Binding SelectedEntry, Converter={StaticResource NotNullToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="10"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    DockPanel.Dock="Left"
                                    Margin="0,0,12,0">
                                <Grid>
                                    <Image Source="{Binding SelectedEntry.IconPath}"
                                           Width="29"
                                           Height="29"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SelectedEntry.IconPath, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedEntry.Type, Converter={StaticResource EntryTypeToGlyphConverter}}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="19"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SelectedEntry.IconPath, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <StackPanel>
                                <TextBox Text="{Binding SelectedEntry.DisplayName, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Foreground="{DynamicResource StrongTextBrush}"
                                         FontSize="21"
                                         FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.TypeLabel, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Common.FullPath}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.PrimaryPath, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         ToolTip="{Binding SelectedEntry.PrimaryPath}"
                                         Margin="0,5,0,14" />

                                <TextBlock Text="{loc:Loc Common.File}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.ExeName, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Margin="0,5,0,14" />

                                <TextBlock Text="{loc:Loc Common.Folder}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.FolderName, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         ToolTip="{Binding SelectedEntry.FolderPath}"
                                         Margin="0,5,0,14" />

                                <TextBlock Text="{loc:Loc Common.Tags}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.TagsText, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Margin="0,5,0,14" />

                                <TextBlock Text="{loc:Loc Common.Note}" FontWeight="SemiBold" />
                                <TextBox Text="{Binding SelectedEntry.Note, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextBoxStyle}"
                                         Margin="0,5,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Common.Added}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SelectedEntry.DateAddedText, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Loc Common.LastOpened}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SelectedEntry.LastOpenedText, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding OpenEntryCommand}"
                                    CommandParameter="{Binding SelectedEntry}"
                                    Content="{loc:Loc Common.Open}"
                                    MinHeight="40" />
                            <UniformGrid Grid.Row="2"
                                         Columns="4"
                                         Rows="1">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenContainingFolderCommand}"
                                        Content="&#xE838;"
                                        ToolTip="{loc:Loc Common.RevealInExplorer}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CopyPathCommand}"
                                        Content="&#xE8C8;"
                                        ToolTip="{loc:Loc Common.CopyFullPath}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ToggleFavoriteCommand}"
                                        CommandParameter="{Binding SelectedEntry}"
                                        Content="{Binding SelectedEntry.IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"
                                        ToolTip="{loc:Loc Common.Favorite}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding DeleteEntryCommand}"
                                        CommandParameter="{Binding SelectedEntry}"
                                        Content="&#xE74D;"
                                        ToolTip="{loc:Loc Main.Action.RemoveFromCatalog}" />
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

                <DockPanel Grid.Row="4"
                           LastChildFill="True">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding StoragePath}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Right"
                               ToolTip="{Binding StoragePath}" />
                </DockPanel>
            </Grid>
            </TabItem>
            <TabItem Header="{loc:Loc Main.Tab.Tasks}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="3"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12" />

                    <DockPanel Margin="18,14,18,0"
                               LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left">
                            <ComboBox Width="164"
                                      Margin="0,0,10,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="{loc:Loc Task.Filter.PriorityAll}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.PriorityHigh}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.PriorityMedium}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.PriorityLow}" />
                            </ComboBox>
                            <ComboBox Width="180"
                                      Margin="0,0,10,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="{loc:Loc Task.Filter.DueAll}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.DueWeek}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.DueMonth}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.Overdue}" />
                            </ComboBox>
                            <ComboBox Width="164"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="{loc:Loc Task.Filter.StatusAll}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.NotStarted}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.InProgress}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.NeedsReview}" />
                                <ComboBoxItem Content="{loc:Loc Task.Filter.Completed}" />
                            </ComboBox>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="160"
                                Content="{loc:Loc Main.Action.CreateTask}"
                                Command="{Binding CreateTaskCommand}" />
                    </DockPanel>

                    <Border Grid.Row="2"
                            Margin="18,0,18,18"
                            Background="{DynamicResource ControlMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="16,14,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" MinWidth="280" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2"
                                           Text="{loc:Loc Task.Field.Title}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3"
                                           Text="{loc:Loc Task.Field.DueDate}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4"
                                           Text="{loc:Loc Task.Field.Status}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5"
                                           Text="{loc:Loc Task.Field.Action}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <ScrollViewer x:Name="TaskListScrollViewer"
                                          Grid.Row="1"
                                          Margin="10,0,10,10"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          CanContentScroll="False">
                                <Grid MinWidth="780"
                                      Width="{Binding ViewportWidth, ElementName=TaskListScrollViewer}"
                                      HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Border Tag="TaskRowRoot"
                                                            Loaded="TaskRow_Loaded"
                                                            Visibility="{Binding ShowDetailedTaskLayout, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="10"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" MinWidth="280" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="320" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource TaskPriorityStripeStyle}"
                                                                    CornerRadius="3" />
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Button Style="{StaticResource TaskTreeIconButtonStyle}"
                                                                        Width="22"
                                                                        Height="22"
                                                                        Padding="0"
                                                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Command="{Binding DataContext.ToggleTaskExpansionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="&#xE76C;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Style="{StaticResource TaskChevronGlyphStyle}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Button>
                                                                <Border Width="22"
                                                                        Height="22"
                                                                        Margin="0,0,6,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="{x:Type Border}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <Button Style="{StaticResource TaskTreeIconButtonStyle}"
                                                                        Content="&#xE710;"
                                                                        ToolTip="{loc:Loc Main.Action.CreateTask}"
                                                                        Command="{Binding DataContext.AddSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Grid VerticalAlignment="Center"
                                                                      MinWidth="180">
                                                                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource TaskInlineTitleEditorStyle}"
                                                                             Visibility="{Binding ShowInlineEditor, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                             Loaded="TaskTitleEditor_Loaded"
                                                                             KeyDown="TaskTitleEditor_KeyDown"
                                                                             LostFocus="TaskTitleEditor_LostFocus" />
                                                                    <TextBlock Text="{Binding TitleOrPlaceholder}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource StrongTextBrush}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding ShowReadOnlyTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                </Grid>
                                                            </StackPanel>

                                                            <Grid Grid.Column="3"
                                                                  VerticalAlignment="Center"
                                                                  Visibility="{Binding ShowDueDate, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <ToggleButton x:Name="DueDateToggle"
                                                                              Style="{StaticResource TaskInlineDateFieldStyle}">
                                                                    <TextBlock Text="{Binding DueDateText}"
                                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                                               VerticalAlignment="Center"
                                                                               TextWrapping="NoWrap" />
                                                                </ToggleButton>
                                                                <Popup IsOpen="{Binding IsChecked, ElementName=DueDateToggle, Mode=TwoWay}"
                                                                       PlacementTarget="{Binding ElementName=DueDateToggle}"
                                                                       Placement="Bottom"
                                                                       StaysOpen="False"
                                                                       AllowsTransparency="True"
                                                                       PopupAnimation="Fade">
                                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="16"
                                                                            Padding="8">
                                                                        <Calendar Style="{StaticResource MaterialDesignCalendarPortrait}"
                                                                                  SelectedDate="{Binding DueDate, Mode=OneWay}"
                                                                                  SelectedDatesChanged="TaskDueDateCalendar_SelectedDatesChanged" />
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>

                                                            <Grid Grid.Column="4"
                                                                  VerticalAlignment="Center">
                                                                <ToggleButton x:Name="StatusToggle"
                                                                              Style="{StaticResource TaskInlineTextToggleStyle}"
                                                                              IsEnabled="{Binding ShowStatusPicker}">
                                                                    <Border Style="{StaticResource TaskStatusBadgeBorderStyle}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="10,4"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding StatusText}"
                                                                                   Style="{StaticResource TaskStatusBadgeTextStyle}"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="12" />
                                                                    </Border>
                                                                </ToggleButton>
                                                                <Popup IsOpen="{Binding IsChecked, ElementName=StatusToggle, Mode=TwoWay}"
                                                                       PlacementTarget="{Binding ElementName=StatusToggle}"
                                                                       Placement="Bottom"
                                                                       StaysOpen="False"
                                                                       AllowsTransparency="True"
                                                                       PopupAnimation="Fade">
                                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="10"
                                                                            Padding="8">
                                                                        <StackPanel>
                                                                            <Button Content="{loc:Loc Task.Status.Todo}"
                                                                                    Tag="Todo"
                                                                                    Click="TaskStatusOption_Click"
                                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                                    Margin="0,0,0,6" />
                                                                            <Button Content="{loc:Loc Task.Status.Ongoing}"
                                                                                    Tag="Ongoing"
                                                                                    Click="TaskStatusOption_Click"
                                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                                    Margin="0,0,0,6" />
                                                                            <Button Content="{loc:Loc Task.Status.Done}"
                                                                                    Tag="Done"
                                                                                    Click="TaskStatusOption_Click"
                                                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>

                                                            <StackPanel Grid.Column="5"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center">
                                                                <Button Style="{StaticResource CompactTaskActionButtonStyle}"
                                                                        Content="{loc:Loc Task.Dialog.MarkCompleted}"
                                                                        Visibility="{Binding ShowMarkCompletedButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.MarkTaskCompletedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Margin="8,0,0,0"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        Content="&#xE70F;"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="{loc:Loc Common.Edit}"
                                                                        Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Margin="8,0,0,0"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        Content="{Binding NotificationIcon}"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="{Binding NotificationToolTip}"
                                                                        Opacity="{Binding NotificationsEnabled, Converter={StaticResource FavoriteOpacityConverter}, ConverterParameter=1}"
                                                                        Command="{Binding DataContext.ToggleTaskNotificationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Margin="8,0,0,0"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        Content="&#xE74D;"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="{loc:Loc Common.Delete}"
                                                                        Click="RemoveTask_Click" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Visibility="{Binding ShowCompactTaskLayout, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          Margin="{Binding Depth, Converter={StaticResource TaskDepthToIndentConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Grid.Column="0"
                                                              Width="22"
                                                              MinHeight="34"
                                                              VerticalAlignment="Stretch">
                                                            <Line X1="8"
                                                                  Y1="0"
                                                                  X2="8"
                                                                  Y2="34"
                                                                  Style="{StaticResource SubtaskConnectorLineStyle}" />
                                                            <Line X1="8"
                                                                  Y1="17"
                                                                  X2="22"
                                                                  Y2="17"
                                                                  Style="{StaticResource SubtaskConnectorLineStyle}" />
                                                        </Grid>

                                                        <Border Grid.Column="1"
                                                                Tag="TaskRowRoot"
                                                                Loaded="TaskRow_Loaded"
                                                                Padding="10,8"
                                                                Background="{DynamicResource ControlBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                            <DockPanel LastChildFill="True">
                                                                <StackPanel DockPanel.Dock="Right"
                                                                            Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Grid Margin="10,0,0,0"
                                                                          VerticalAlignment="Center">
                                                                        <ToggleButton x:Name="CompactStatusToggle"
                                                                                      Style="{StaticResource TaskInlineTextToggleStyle}"
                                                                                      IsEnabled="{Binding ShowStatusPicker}">
                                                                            <Border Style="{StaticResource TaskStatusBadgeBorderStyle}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="6"
                                                                                    Padding="10,4"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding StatusText}"
                                                                                           Style="{StaticResource TaskStatusBadgeTextStyle}"
                                                                                           FontWeight="SemiBold"
                                                                                           FontSize="12" />
                                                                            </Border>
                                                                        </ToggleButton>
                                                                        <Popup IsOpen="{Binding IsChecked, ElementName=CompactStatusToggle, Mode=TwoWay}"
                                                                               PlacementTarget="{Binding ElementName=CompactStatusToggle}"
                                                                               Placement="Bottom"
                                                                               StaysOpen="False"
                                                                               AllowsTransparency="True"
                                                                               PopupAnimation="Fade">
                                                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="10"
                                                                                    Padding="8">
                                                                                <StackPanel>
                                                                                    <Button Content="{loc:Loc Task.Status.Todo}"
                                                                                            Tag="Todo"
                                                                                            Click="TaskStatusOption_Click"
                                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                                            Margin="0,0,0,6" />
                                                                                    <Button Content="{loc:Loc Task.Status.Ongoing}"
                                                                                            Tag="Ongoing"
                                                                                            Click="TaskStatusOption_Click"
                                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                                            Margin="0,0,0,6" />
                                                                                    <Button Content="{loc:Loc Task.Status.Done}"
                                                                                            Tag="Done"
                                                                                            Click="TaskStatusOption_Click"
                                                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Popup>
                                                                    </Grid>
                                                                    <Button Margin="8,0,0,0"
                                                                            Style="{StaticResource IconButtonStyle}"
                                                                            Content="&#xE70F;"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip="{loc:Loc Common.Edit}"
                                                                            Command="{Binding DataContext.BeginInlineRenameTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Margin="8,0,0,0"
                                                                            Style="{StaticResource IconButtonStyle}"
                                                                            Content="&#xE74D;"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip="{loc:Loc Common.Delete}"
                                                                            Click="RemoveTask_Click" />
                                                                </StackPanel>

                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource TaskTreeIconButtonStyle}"
                                                                            Width="22"
                                                                            Height="22"
                                                                            Padding="0"
                                                                            Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                            Command="{Binding DataContext.ToggleTaskExpansionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Text="&#xE76C;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="12"
                                                                                   Style="{StaticResource TaskChevronGlyphStyle}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Button>
                                                                    <Border Width="22"
                                                                            Height="22"
                                                                            Margin="0,0,6,0">
                                                                        <Border.Style>
                                                                            <Style TargetType="{x:Type Border}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <Button Style="{StaticResource TaskTreeIconButtonStyle}"
                                                                            Content="&#xE710;"
                                                                            ToolTip="{loc:Loc Main.Action.CreateTask}"
                                                                            Command="{Binding DataContext.AddSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Grid VerticalAlignment="Center"
                                                                          MinWidth="180">
                                                                        <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Style="{StaticResource TaskInlineTitleEditorStyle}"
                                                                                 Visibility="{Binding ShowInlineEditor, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                 Loaded="TaskTitleEditor_Loaded"
                                                                                 KeyDown="TaskTitleEditor_KeyDown"
                                                                                 LostFocus="TaskTitleEditor_LostFocus" />
                                                                        <TextBlock Text="{Binding TitleOrPlaceholder}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource StrongTextBrush}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Visibility="{Binding ShowReadOnlyTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:Loc Main.Tab.Note}">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="{loc:Loc Main.Note.Title}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NoteResultCountText}"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <TextBox Text="{Binding NoteSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:Loc Main.Tooltip.SearchNotes}" />
                                <TextBlock Margin="14,0,42,0"
                                           Text="{loc:Loc Main.Placeholder.SearchNotes}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding NoteSearchText, Converter={StaticResource SearchPlaceholderConverter}}" />
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Width="150"
                                              ItemsSource="{Binding NoteFilters}"
                                              ItemTemplate="{StaticResource CenteredDropdownTextTemplate}"
                                              SelectedItem="{Binding SelectedNoteFilterOption}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{loc:Loc Main.Action.NewNote}"
                                            Height="34"
                                            MinWidth="104"
                                            Padding="14,4"
                                            FontSize="13"
                                            Command="{Binding CreateNoteCommand}" />
                                </Grid>

                                <ListBox Grid.Row="2"
                                         Style="{StaticResource SmoothCatalogListBoxStyle}"
                                         ItemsSource="{Binding NotesView}"
                                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                                         HorizontalContentAlignment="Stretch"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="NoteCard"
                                                    Margin="0,0,0,10"
                                                    Padding="14"
                                                    Background="{DynamicResource ControlMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="6" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="15"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                Width="32"
                                                                Height="30"
                                                                FontSize="13"
                                                                Content="&#xE734;"
                                                                Opacity="{Binding IsFavorite, Converter={StaticResource FavoriteOpacityConverter}}"
                                                                ToolTip="{loc:Loc Common.ToggleFavorite}"
                                                                Command="{Binding DataContext.ToggleNoteFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding BodyPreview}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="40" />

                                                    <StackPanel Grid.Row="4">
                                                        <TextBlock Text="{Binding UpdatedAtText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding TagsText}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding TagsText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="NoteCard" Property="Background" Value="{DynamicResource SelectedItemBrush}" />
                                                    <Setter TargetName="NoteCard" Property="BorderBrush" Value="{DynamicResource SelectedItemBorderBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="4"
                                        Padding="14"
                                        Background="{DynamicResource ControlMutedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Main.Note.EmptyTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15" />
                                        <TextBlock Text="{loc:Loc Main.Note.EmptyMessage}"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <Grid>
                            <Grid Visibility="{Binding SelectedNote, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{loc:Loc Main.Note.EditorTitle}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               DockPanel.Dock="Left" />
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Margin="0,0,8,0"
                                                Content="&#xE734;"
                                                ToolTip="{loc:Loc Common.ToggleFavorite}"
                                                Command="{Binding ToggleNoteFavoriteCommand}"
                                                CommandParameter="{Binding SelectedNote}" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{loc:Loc Common.Delete}"
                                                Padding="14,8"
                                                Command="{Binding DeleteNoteCommand}"
                                                CommandParameter="{Binding SelectedNote}" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="2">
                                    <TextBox Text="{Binding NoteEditorTitle, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="20"
                                             FontWeight="SemiBold"
                                             ToolTip="{loc:Loc Main.Tooltip.NoteTitle}" />
                                    <TextBlock Margin="14,0,14,0"
                                               Text="{loc:Loc Main.Placeholder.NoteTitle}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding NoteEditorTitle, Converter={StaticResource SearchPlaceholderConverter}}" />
                                </Grid>

                                <Grid Grid.Row="4">
                                    <TextBox Text="{Binding NoteEditorTagsText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:Loc Main.Tooltip.NoteTags}" />
                                    <TextBlock Margin="14,0,14,0"
                                               Text="{loc:Loc Main.Placeholder.NoteTags}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding NoteEditorTagsText, Converter={StaticResource SearchPlaceholderConverter}}" />
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid>
                                        <RichTextBox Style="{StaticResource EditableNoteBodyStyle}"
                                                     AcceptsReturn="True"
                                                     behaviors:EditableTextLinkifier.BoundText="{Binding NoteEditorBody, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="14,12,14,12"
                                                   Text="{loc:Loc Main.Placeholder.NoteBody}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Top"
                                                   TextWrapping="Wrap"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding NoteEditorBody, Converter={StaticResource SearchPlaceholderConverter}}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <StackPanel Visibility="{Binding SelectedNote, Converter={StaticResource NullToVisibilityConverter}}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        MaxWidth="340">
                                <TextBlock Text="{loc:Loc Main.Note.ChooseTitle}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{loc:Loc Main.Note.ChooseMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>
            <TabItem Header="{loc:Loc Main.Tab.AiBridge}"
                     MinWidth="120">
                <views:AiBridgeView Margin="0,14,0,0" />
            </TabItem>
        </TabControl>
        </Grid>

        <Grid Grid.RowSpan="2"
              Panel.ZIndex="20"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Rectangle Fill="{DynamicResource PageBrush}"
                       Opacity="0.94" />
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid Width="54"
                      Height="54"
                      HorizontalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource BorderBrush}"
                             StrokeThickness="5"
                             Opacity="0.65" />
                    <Ellipse Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="5"
                             StrokeDashArray="2 5"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LoadingRingRotate" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadingRingRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.85" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="{Binding LoadingMessage}"
                           Foreground="{DynamicResource StrongTextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
