<Window x:Class="LauncherCatalog.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc Settings.Window.Title}"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="460"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsCategoryItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0"
                Background="#AA5C4B3E"
                BorderBrush="#806F5A4A"
                BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Settings.Window.Title}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFF4EDE6"
                           FontWeight="SemiBold"
                           FontSize="12" />
                <Button Grid.Column="1"
                        Width="44"
                        Height="36"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#FFF4EDE6"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;"
                        Click="TitleClose_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <!-- Body: left categories + right detail -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="CategoryList"
                         Margin="0,10,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectedIndex="0"
                         ItemContainerStyle="{StaticResource SettingsCategoryItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{loc:Loc Settings.Category.General}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Right detail panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GeneralPanel" Margin="28,26,28,10">
                        <!-- Appearance -->
                        <Border Style="{StaticResource SettingsSectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Section.Appearance}"
                                           Style="{StaticResource SettingsSectionTitleStyle}" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Settings.Appearance.DarkMode}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StrongTextBrush}" />
                                        <TextBlock Text="{loc:Loc Settings.Appearance.ThemeHint}"
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource SwitchButtonStyle}"
                                                  IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                                  ToolTip="{loc:Loc Common.ToggleDarkMode}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Language -->
                        <Border Style="{StaticResource SettingsSectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Section.Language}"
                                           Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="{loc:Loc Settings.Language.Label}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StrongTextBrush}"
                                           Margin="0,18,0,0" />
                                <TextBlock Text="{loc:Loc Settings.Language.Hint}"
                                           Style="{StaticResource SettingsHintStyle}" />
                                <ComboBox Margin="0,14,0,0"
                                          Width="240"
                                          HorizontalAlignment="Left"
                                          Padding="10,6"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                        </Border>

                        <!-- Quick Search shortcut -->
                        <Border Style="{StaticResource SettingsSectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings.Section.QuickSearch}"
                                           Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="{loc:Loc Settings.QuickSearch.Label}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StrongTextBrush}"
                                           Margin="0,18,0,0" />
                                <TextBlock Text="{loc:Loc Settings.QuickSearch.Hint}"
                                           Style="{StaticResource SettingsHintStyle}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource ControlMutedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10">
                                        <TextBlock x:Name="HotkeyDisplay"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StrongTextBrush}" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            MinWidth="96"
                                            Content="{loc:Loc Settings.QuickSearch.Change}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ChangeHotkey_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: OK closes the dialog (settings already applied) -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="22,14">
                    <Button HorizontalAlignment="Right"
                            MinWidth="96"
                            Content="{loc:Loc Common.Ok}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Ok_Click" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
