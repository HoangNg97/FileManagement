<UserControl x:Class="LauncherCatalog.Views.HistoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LauncherCatalog.Converters"
             xmlns:loc="clr-namespace:LauncherCatalog.Services"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:LauncherCatalog.Views"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVisibilityConverter" Invert="True" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="SearchPlaceholderConverter" />

        <Style x:Key="HistoryIconToggleButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style x:Key="HistoryOverlayComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="materialDesign:TextFieldAssist.HasOutlinedTextField" Value="True" />
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="8" />
            <Setter Property="materialDesign:TextFieldAssist.OutlinedBorderActiveThickness" Value="1" />
            <Setter Property="materialDesign:TextFieldAssist.RippleOnFocusEnabled" Value="False" />
        </Style>

        <Style x:Key="ExpandingHistorySearchStyle" TargetType="{x:Type Border}">
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.96" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowEventSearch}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="MaxWidth"
                                                 To="900"
                                                 Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="MaxWidth"
                                                 To="0"
                                                 Duration="0:0:0.14" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.10" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="0.96"
                                                 Duration="0:0:0.14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid PreviewMouseDown="Root_PreviewMouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="315" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{loc:Loc History.Title}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FileCountText}"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <Button Grid.Row="2"
                        Content="{loc:Loc History.Action.CreateFile}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,12"
                        MinHeight="42"
                        Click="CreateHistoryFile_Click" />

                <Grid Grid.Row="4">
                    <TextBox Text="{Binding FileSearchText, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="38"
                             ToolTip="{loc:Loc History.Tooltip.SearchFiles}" />
                    <TextBlock Margin="14,0,14,0"
                               Text="{loc:Loc History.Placeholder.SearchFiles}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding FileSearchText, Converter={StaticResource SearchPlaceholderConverter}}" />
                </Grid>

                <Grid Grid.Row="6">
                    <ListBox ItemsSource="{Binding HistoryFiles}"
                             SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="HistoryFileCard"
                                        Margin="0,0,0,10"
                                        Padding="14"
                                        Background="{DynamicResource ControlMutedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc Common.Edit}"
                                                      Click="EditHistoryFile_Click" />
                                            <MenuItem Header="{loc:Loc Common.ToggleFavorite}"
                                                      Click="ToggleHistoryFileFavorite_Click" />
                                            <Separator />
                                            <MenuItem Header="{loc:Loc Common.Delete}"
                                                      Click="DeleteHistoryFile_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="&#xE734;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding CreatedDateText}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12" />
                                        <TextBlock Grid.Row="4"
                                                   Text="{Binding TagsText}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding TagsText}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="HistoryFileCard" Property="Background" Value="{DynamicResource SelectedItemBrush}" />
                                        <Setter TargetName="HistoryFileCard" Property="BorderBrush" Value="{DynamicResource SelectedItemBorderBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Padding="14"
                            Background="{DynamicResource ControlMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc History.File.EmptyTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="15" />
                            <TextBlock Text="{loc:Loc History.File.EmptyMessage}"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <Grid>
                <Grid Visibility="{Binding SelectedFile, Converter={StaticResource NullToVisibilityConverter}}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxWidth="390">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc History.Empty.SelectFileTitle}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{loc:Loc History.Empty.SelectFileMessage}"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Visibility="{Binding SelectedFile, Converter={StaticResource NotNullToVisibilityConverter}}"
                        Background="{DynamicResource ControlMutedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <ScrollViewer x:Name="RouteScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      CanContentScroll="False">
                            <views:HistoryRouteMap x:Name="RouteMap"
                                                   Events="{Binding VisibleEvents}"
                                                   SelectedEvent="{Binding SelectedEvent}"
                                                   HighlightedEventId="{Binding HighlightedEventId}"
                                                   EventSelectedCommand="{Binding SelectEventCommand}"
                                                   ClearHighlightCommand="{Binding ClearHighlightCommand}" />
                        </ScrollViewer>

                        <Grid Margin="14"
                              VerticalAlignment="Top"
                              Panel.ZIndex="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="0,0,12,0"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource HistoryIconToggleButtonStyle}"
                                        Content="&#xE721;"
                                        ToolTip="{loc:Loc History.Tooltip.SearchEvents}"
                                        Click="ToggleEventSearch_Click" />
                                <Border x:Name="EventSearchBoxPanel"
                                        Grid.Column="2"
                                        Style="{StaticResource ExpandingHistorySearchStyle}">
                                    <Grid>
                                        <TextBox x:Name="EventSearchTextBox"
                                                 Text="{Binding EventSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="36"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource StrongTextBrush}"
                                                 CaretBrush="{DynamicResource StrongTextBrush}"
                                                 Padding="14,7"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="{loc:Loc History.Tooltip.SearchEvents}" />
                                        <TextBlock Margin="14,0,14,0"
                                                   Text="{loc:Loc History.Placeholder.SearchEvents}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding EventSearchText, Converter={StaticResource SearchPlaceholderConverter}}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <WrapPanel Grid.Column="1"
                                       HorizontalAlignment="Right">
                                <ComboBox Width="82"
                                          Margin="0,0,8,0"
                                          Style="{StaticResource HistoryOverlayComboBoxStyle}"
                                          ItemsSource="{Binding SelectableYears}"
                                          SelectedItem="{Binding SelectedYear}" />
                                <ComboBox Width="100"
                                          Margin="0,0,8,0"
                                          Style="{StaticResource HistoryOverlayComboBoxStyle}"
                                          ItemsSource="{Binding SelectableMonths}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedMonthOption}" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{loc:Loc History.Action.NewEvent}"
                                        Height="36"
                                        Padding="14,6"
                                        Margin="0,0,8,0"
                                        Click="NewEvent_Click" />
                                <Button x:Name="ExportButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{loc:Loc History.Action.Export}"
                                        Height="36"
                                        Padding="14,6"
                                        Click="ExportButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc History.Action.ExportMonth}"
                                                      Click="ExportSelectedMonth_Click" />
                                            <MenuItem Header="{loc:Loc History.Action.ExportAll}"
                                                      Click="ExportAllEvents_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <Border Margin="24"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="380"
                                Panel.ZIndex="9"
                                Visibility="{Binding HasNoVisibleEvents, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc History.Event.EmptyMonthTitle}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{loc:Loc History.Event.EmptyMonthMessage}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="#AA000000"
                                CornerRadius="12"
                                Panel.ZIndex="12"
                                Visibility="{Binding IsVisualizationLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Padding="22"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MinWidth="260">
                                <StackPanel>
                                    <ProgressBar IsIndeterminate="True"
                                                 Height="4"
                                                 Margin="0,0,0,14" />
                                    <TextBlock Text="{loc:Loc History.Visualization.LoadingTitle}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center" />
                                    <TextBlock Text="{loc:Loc History.Visualization.LoadingMessage}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Border>

                        <Border x:Name="EventSearchResultsPanel"
                                Margin="62,60,18,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="320"
                                Panel.ZIndex="11"
                                Visibility="{Binding HasEventSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="160" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc History.Search.ResultsTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <ListBox x:Name="EventSearchResultsList"
                                         Grid.Row="2"
                                         ItemsSource="{Binding EventSearchResults}"
                                         SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="{DynamicResource ControlMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding EventDateText}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ShortNote}"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
