<Window x:Class="LauncherCatalog.Views.HistoryFileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LauncherCatalog.Converters"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding DialogTitle, RelativeSource={RelativeSource Self}}"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="SearchPlaceholderConverter" />
    </Window.Resources>

    <Grid>
        <Border Height="36"
                VerticalAlignment="Top"
                Background="#AA5C4B3E"
                BorderBrush="#806F5A4A"
                BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFF4EDE6"
                           FontWeight="SemiBold"
                           FontSize="12" />
                <Button Grid.Column="1"
                        Width="44"
                        Height="36"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#FFF4EDE6"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;"
                        Click="Cancel_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Border Margin="18,54,18,18"
                Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="10"
                            Background="{DynamicResource AccentSoftBrush}"
                            DockPanel.Dock="Left"
                            Margin="0,0,12,0">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DialogSubtitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc History.Field.FileName}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <TextBox Text="{Binding FileName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="14,0,14,0"
                                       Text="{loc:Loc History.Placeholder.FileName}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding FileName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SearchPlaceholderConverter}}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{loc:Loc Common.Tags}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <TextBox Text="{Binding TagsText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="14,0,14,0"
                                       Text="{loc:Loc History.Placeholder.FileTags}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding TagsText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SearchPlaceholderConverter}}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="4"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed" />

                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Common.Cancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click" />
                    <Button Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="150"
                            Padding="18,12"
                            Click="Create_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
