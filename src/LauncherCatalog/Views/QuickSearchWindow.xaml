<Window x:Class="LauncherCatalog.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LauncherCatalog.Converters"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        Title="{loc:Loc QuickSearch.Title}"
        Width="780"
        MinHeight="112"
        MaxHeight="440"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <conv:EntryTypeToGlyphConverter x:Key="EntryTypeToGlyphConverter" />
    </Window.Resources>
    <Border Margin="1"
            Padding="20"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Opacity="0.18" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border MinHeight="50"
                    MinWidth="740"
                    Background="{DynamicResource ControlBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             CaretBrush="#1E3A8A"
                             FontSize="18"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                </Grid>
            </Border>

            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     Margin="0,14,0,0"
                     ItemsSource="{Binding}"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     BorderThickness="0"
                     Background="Transparent"
                     Visibility="Collapsed"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     VirtualizingPanel.IsVirtualizing="False"
                     MaxHeight="318">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ResultBorder"
                                Padding="12"
                                Background="{DynamicResource ControlMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Type, Converter={StaticResource EntryTypeToGlyphConverter}}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PrimaryPathPreview}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PrimaryPath}" />
                                </StackPanel>
                                <Border Grid.Column="4"
                                        Padding="8,3"
                                        CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceLabel}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="ResultBorder" Property="Background" Value="{DynamicResource SelectedItemBrush}" />
                                <Setter TargetName="ResultBorder" Property="BorderBrush" Value="{DynamicResource SelectedItemBorderBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
