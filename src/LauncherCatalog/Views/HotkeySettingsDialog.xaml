<Window x:Class="LauncherCatalog.Views.HotkeySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Quick Search Shortcut"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
    <Border Height="36"
            VerticalAlignment="Top"
            Background="#AA5C4B3E"
            BorderBrush="#806F5A4A"
            BorderThickness="0,0,0,1"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Quick Search Shortcut"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#FFF4EDE6"
                       FontWeight="SemiBold"
                       FontSize="12" />
            <Button Grid.Column="1"
                    Width="44"
                    Height="36"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#FFF4EDE6"
                    FontFamily="Segoe MDL2 Assets"
                    Content="&#xE8BB;"
                    Click="TitleClose_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
    </Border>
    <Border Margin="18,54,18,18"
            Padding="22"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Border Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0">
                    <TextBlock Text="&#xE765;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Quick search shortcut"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Press the key combination to use."
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="2"
                    Padding="16"
                    Background="{DynamicResource ControlMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock x:Name="ShortcutText"
                           Text="{Binding}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Reset"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="86"
                        Click="Reset_Click"
                        Margin="0,0,10,0" />
                <Button Content="Close"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="86"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
