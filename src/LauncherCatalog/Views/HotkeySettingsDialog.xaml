<Window x:Class="LauncherCatalog.Views.HotkeySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Search Shortcut"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="18"
            Padding="22"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Border Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0">
                    <TextBlock Text="&#xE765;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Quick search shortcut"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Press the key combination to use."
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="2"
                    Padding="16"
                    Background="{DynamicResource ControlMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock x:Name="ShortcutText"
                           Text="{Binding}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Reset"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="86"
                        Click="Reset_Click"
                        Margin="0,0,10,0" />
                <Button Content="Close"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="86"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
