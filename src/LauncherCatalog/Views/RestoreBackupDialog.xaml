<Window x:Class="LauncherCatalog.Views.RestoreBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc Backup.RestoreDialog.Title}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Border Height="36"
                VerticalAlignment="Top"
                Background="#AA5C4B3E"
                BorderBrush="#806F5A4A"
                BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Backup.RestoreDialog.Title}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFF4EDE6"
                           FontWeight="SemiBold"
                           FontSize="12" />
                <Button Grid.Column="1"
                        Width="44"
                        Height="36"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#FFF4EDE6"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;"
                        Click="TitleClose_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Border Margin="18,54,18,18"
                Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Border Width="42"
                            Height="42"
                            CornerRadius="10"
                            Background="{DynamicResource AccentSoftBrush}"
                            DockPanel.Dock="Left"
                            Margin="0,0,12,0">
                        <TextBlock Text="&#xE777;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Backup.RestoreDialog.Heading}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc Backup.RestoreDialog.Subtitle}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{loc:Loc Backup.RestoreDialog.VersionLabel}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <ComboBox x:Name="VersionComboBox"
                              ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                              DisplayMemberPath="DisplayText"
                              Height="34" />
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Common.Cancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="92"
                            Click="Cancel_Click"
                            Margin="0,0,10,0" />
                    <Button Content="{loc:Loc Common.Restore}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="92"
                            Click="Restore_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
