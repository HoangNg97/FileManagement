<Window x:Class="LauncherCatalog.Views.ImportConversationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc Issues.Import.Title}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </Window.Resources>
    <Grid>
        <Border Height="36"
                VerticalAlignment="Top"
                Background="#AA5C4B3E"
                BorderBrush="#806F5A4A"
                BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Issues.Import.Title}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFF4EDE6"
                           FontWeight="SemiBold"
                           FontSize="12" />
                <Button Grid.Column="1"
                        Width="44"
                        Height="36"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#FFF4EDE6"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;"
                        Click="TitleClose_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Border Margin="18,54,18,18"
                Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Copyable, read-only prompt for generating an importable JSON file -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{loc:Loc Issues.Import.PromptLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="PromptBox"
                             Text="{loc:Loc Issues.Import.Prompt}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             MinHeight="150"
                             MaxHeight="260"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12" />
                </StackPanel>

                <!-- Read-only selected-file display -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{loc:Loc Issues.Import.FileLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="FileNameBox"
                             IsReadOnly="True"
                             Focusable="False"
                             Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <!-- Actions -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            MinWidth="96"
                            Content="{loc:Loc Issues.Import.Open}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Open_Click" />
                    <Button Grid.Column="2"
                            x:Name="ImportButton"
                            MinWidth="96"
                            IsEnabled="False"
                            Content="{loc:Loc Issues.Import.Import}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Import_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
