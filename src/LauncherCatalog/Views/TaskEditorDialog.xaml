<Window x:Class="LauncherCatalog.Views.TaskEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="DateFieldButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </Window.Resources>
    <Grid>
    <Border Height="36"
            VerticalAlignment="Top"
            Background="#AA5C4B3E"
            BorderBrush="#806F5A4A"
            BorderThickness="0,0,0,1"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding WindowTitle}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#FFF4EDE6"
                       FontWeight="SemiBold"
                       FontSize="12" />
            <Button Grid.Column="1"
                    Width="44"
                    Height="36"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#FFF4EDE6"
                    FontFamily="Segoe MDL2 Assets"
                    Content="&#xE8BB;"
                    Click="TitleClose_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
    </Border>

    <Border Margin="18,54,18,18"
            Padding="22"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Border Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0">
                    <TextBlock Text="&#xE8FD;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SubtitleText}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{loc:Loc Task.Field.TaskTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Loc Task.Field.Status}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Border Height="34"
                                Grid.Row="1"
                                Padding="12,0"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource ControlMutedBrush}"
                                Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusDisplay}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource StrongTextBrush}" />
                        </Border>
                        <ComboBox ItemsSource="{Binding Statuses}"
                                  Grid.Row="1"
                                  SelectedItem="{Binding SelectedStatusOption}"
                                  DisplayMemberPath="DisplayText"
                                  Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                  HorizontalAlignment="Stretch"
                                  MinHeight="34" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Loc Task.Field.Priority}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Priorities}"
                                  Grid.Row="1"
                                  SelectedItem="{Binding SelectedPriorityOption}"
                                  DisplayMemberPath="DisplayText"
                                  HorizontalAlignment="Stretch"
                                  Height="34" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="{loc:Loc Task.Field.DueDate}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Button x:Name="DueDateField"
                                Style="{StaticResource DateFieldButtonStyle}"
                                Click="DueDateField_Click"
                                Content="{Binding DueDateText}" />
                        <Popup x:Name="DueDatePopup"
                               PlacementTarget="{Binding ElementName=DueDateField}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="8">
                                <Calendar x:Name="DueDateCalendar"
                                          Style="{StaticResource MaterialDesignCalendarPortrait}"
                                          SelectedDatesChanged="DueDateCalendar_SelectedDatesChanged" />
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="6">
                    <TextBlock Text="{loc:Loc Common.Note}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             Height="88"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{loc:Loc Common.Cancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="92"
                        Click="Cancel_Click"
                        Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="92"
                        Content="{Binding ActionButtonText}"
                        Click="Create_Click" />
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
