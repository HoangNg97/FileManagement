<Window x:Class="LauncherCatalog.Views.EntryEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="TagChipButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Grid>
    <Border Height="36"
            VerticalAlignment="Top"
            Background="#AA5C4B3E"
            BorderBrush="#806F5A4A"
            BorderThickness="0,0,0,1"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding WindowTitle}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#FFF4EDE6"
                       FontWeight="SemiBold"
                       FontSize="12" />
            <Button Grid.Column="1"
                    Width="44"
                    Height="36"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#FFF4EDE6"
                    FontFamily="Segoe MDL2 Assets"
                    Content="&#xE8BB;"
                    Click="TitleClose_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
    </Border>

    <Border Margin="18,54,18,18"
            Padding="22"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Border Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0">
                    <TextBlock Text="{Binding BrowseGlyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Entry.Dialog.Subtitle}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{loc:Loc Entry.Dialog.DisplayName}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding PathLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Browse_Click"
                                ToolTip="{loc:Loc Common.Browse}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding BrowseGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Loc Common.Browse}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Entry.Dialog.FileName}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ExeName, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource ControlMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Entry.Dialog.FolderName}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding FolderName, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource ControlMutedBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="6">
                    <TextBlock Text="{loc:Loc Common.Tags}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl ItemsSource="{Binding AvailableRecentTags}"
                                  Visibility="{Binding HasAvailableRecentTags, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.AddRecentTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource TagChipButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="8">
                    <TextBlock Text="{loc:Loc Common.Note}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             Height="88"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{loc:Loc Common.Cancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="92"
                        Click="Cancel_Click"
                        Margin="0,0,10,0" />
                <Button Content="{loc:Loc Common.Save}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="92"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
