<Window x:Class="LauncherCatalog.Views.NewIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LauncherCatalog.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc Issues.NewIssue.Title}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </Window.Resources>
    <Grid>
        <Border Height="36"
                VerticalAlignment="Top"
                Background="#AA5C4B3E"
                BorderBrush="#806F5A4A"
                BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderText"
                           Text="{loc:Loc Issues.NewIssue.Title}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FFF4EDE6"
                           FontWeight="SemiBold"
                           FontSize="12" />
                <Button Grid.Column="1"
                        Width="44"
                        Height="36"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#FFF4EDE6"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE8BB;"
                        Click="TitleClose_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Border Margin="18,54,18,18"
                Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{loc:Loc Issues.Field.Title}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TitleBox" MaxLength="200" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{loc:Loc Issues.Field.Note}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="NoteBox"
                             MinHeight="96"
                             MaxHeight="220"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button MinWidth="96"
                            Margin="0,0,10,0"
                            Content="{loc:Loc Common.Cancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click" />
                    <Button x:Name="PrimaryButton"
                            MinWidth="96"
                            Content="{loc:Loc Issues.NewIssue.Create}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Create_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
