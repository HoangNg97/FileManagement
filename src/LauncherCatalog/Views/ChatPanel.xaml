<UserControl x:Class="LauncherCatalog.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LauncherCatalog.Services"
             xmlns:models="clr-namespace:LauncherCatalog.Models"
             xmlns:behaviors="clr-namespace:LauncherCatalog.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="440">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ChatSendButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="PanelRoot"
            Width="440"
            Height="560"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            RenderTransformOrigin="1,0"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.25"
                              ShadowDepth="6"
                              Color="Black" />
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
        </Border.RenderTransform>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="14,14,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{loc:Loc Chat.Subtitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource ChatIconButtonStyle}"
                            Content="&#xE72C;"
                            Margin="6,0,0,0"
                            ToolTip="{loc:Loc Chat.NewConversation}"
                            Command="{Binding NewConversationCommand}"
                            FontSize="13" />
                    <Button Grid.Column="2"
                            Style="{StaticResource ChatIconButtonStyle}"
                            Content="&#xE711;"
                            Margin="4,0,0,0"
                            ToolTip="{loc:Loc Chat.Close}"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <!-- Message list -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MessageScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,14,14,4">
                    <ItemsControl x:Name="MessageList"
                                  ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="12,9"
                                            CornerRadius="12"
                                            MaxWidth="340">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <RichTextBox behaviors:TextLinkifier.BoundText="{Binding Content}"
                                                         IsReadOnly="True"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         IsDocumentEnabled="True"
                                                         Focusable="False">
                                                <RichTextBox.Style>
                                                    <Style TargetType="{x:Type RichTextBox}">
                                                        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RichTextBox.Style>
                                            </RichTextBox>
                                            <TextBlock Text="{loc:Loc Chat.Thinking}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontStyle="Italic"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding EmptyStateText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="13"
                           TextAlignment="Center"
                           Margin="24"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!-- Error banner above input -->
            <Border Grid.Row="2"
                    Background="#332B1D1D"
                    BorderBrush="#66C25050"
                    BorderThickness="0,1,0,0"
                    Padding="14,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#FFE58A8A"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorText}"
                               Foreground="#FFE58A8A"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Input -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12"
                    CornerRadius="0,0,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox"
                             Grid.Column="0"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10,8"
                             Background="{DynamicResource ControlBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Foreground="{DynamicResource StrongTextBrush}"
                             CaretBrush="{DynamicResource StrongTextBrush}"
                             KeyDown="InputBox_KeyDown"
                             Tag="{Binding InputPlaceholder}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ChatSendButtonStyle}"
                            Content="{loc:Loc Chat.Send}"
                            Command="{Binding SendCommand}"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
